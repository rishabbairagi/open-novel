# Copy to .env.local. Never commit real tokens.
# Fine-grained PAT with "Contents: read/write" and "Pull requests: read/write" on the content repo.
GITHUB_PAT_TOKEN=ghp_yourPersonalAccessToken
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=your-repo-name
# Optional, defaults to "main"
GITHUB_BASE_BRANCH=main
REVALIDATION_SECRET=your_webhook_secret_here
